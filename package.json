{
  "name": "catchup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc",
    "test": "node --import tsx --test src/recap.test.ts",
    "recap": "node --import tsx src/recap-latest.ts",
    "replay": "node --import tsx src/replay.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
